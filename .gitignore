.env
.env.*

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Word data backups (timestamped snapshots, redundant with git history)
data/words/backup_*/

# Word generation work-in-progress files
/todo_*.txt
/word_batches

# Play Store screenshots (regenerable, 1.5M)
store/screenshots/

# Agent working documents live in the private Kalmi91/ai-workspace repo and
# are symlinked back into this tree, so the paths stay the same for tooling.
/AGENTS.md
/BUILD.md
/GAMES.md
/BUGS.md
/ITER3.md
/ITER4.md
/ITER5.md
docs/UI-NEVEK.md
/ITER1.1-PLAN.txt
/TASK.md
/skills

# Local Claude Code MCP config (empty stub, not project state)
.mcp.json

# Empty package-manager stubs, local only.
/.npmrc
/.yarnrc
/.yarnrc.yml

# Claude Code writes session state here; only the project config and the
# build skill are part of the repository.
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/build-apk/
