#!/bin/sh
# Conventional Commits, the format the whole history already uses.
# Enable once per clone:  git config core.hooksPath .githooks

subject=$(head -1 "$1")

# No AI attribution lines: this repository keeps its history free of them.
if grep -v '^#' "$1" | grep -qiE 'Co-Authored-By:.*(Claude|Anthropic)|Generated with.*Claude|Claude-Session'; then
  echo "Commit message must not carry an AI attribution line (Co-Authored-By, Generated with, Claude-Session)." >&2
  exit 1
fi

# Let git's own generated messages through (merge, revert, fixup, squash).
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

if printf '%s' "$subject" | grep -qE '^(feat|fix|chore|docs|test|refactor|build|ci|perf|style|revert)(\([a-z0-9 ._+-]+\))?!?: .+'; then
  exit 0
fi

cat >&2 <<EOF
Commit message must be a Conventional Commit:

  <type>(<scope>): <what it does for the user>

  types: feat fix chore docs test refactor build ci perf style revert
  e.g.   feat(learn): one Check button, docked above the keyboard

Got: $subject
EOF
exit 1
