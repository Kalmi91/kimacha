      "id": "ser-estar",
      "title": "Use estar for a temporary state, not ser",
      "rule": "A temporary state or condition uses estar, not ser: está bien, estoy confundido.",
      "lessons": ["ser-estar"],
      "drills": [
        { "id": "d1", "prompt": "Eso ___ bien. (estar)", "answer": "está", "en": "That's fine." },
