{
  "name": "kimacha",
  "description": "Spaced-repetition vocabulary and grammar trainer for learning Spanish and English",
  "main": "expo-router/entry",
  "version": "4.1.32",
  "dependencies": {
    "@dr.pogodin/react-native-fs": "2.40.4",
    "@kesha-antonov/react-native-background-downloader": "^4.7.0",
    "expo": "~56.0.23",
    "expo-audio": "~56.0.13",
    "expo-build-properties": "~56.0.27",
    "expo-constants": "~56.0.15",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.5",
    "expo-linking": "~56.0.18",
    "expo-router": "~56.2.21",
    "expo-sharing": "~56.0.26",
    "expo-speech": "~56.0.3",
    "expo-speech-recognition": "~56.0.4",
    "expo-splash-screen": "~56.0.15",
    "expo-sqlite": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-sherpa-onnx": "0.4.4",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "fast-check": "^4.10.2",
    "firebase-tools": "^15.34.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "knip": "^5.88.1",
    "react-test-renderer": "19.2.3",
    "sql.js": "^1.15.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:mutation": "stryker run",
    "gen:content": "node scripts/gen-content-index.mjs",
    "gen:names": "node scripts/gen-corpus-names.mjs",
    "check:de-course": "node scripts/grammar-de-course-check.mjs",
    "audit:data": "node scripts/words-open-check.mjs && node scripts/validate-en-track.mjs && node scripts/audit-corpus-en.mjs && node scripts/audit-games.mjs && node scripts/grammar-de-course-check.mjs",
    "gate": "npm run typecheck:ci && npm run lint && npm run test:ci && npm run audit:data",
    "check-keystore": "node scripts/check-keystore.mjs",
    "smoke:release": "node scripts/release-smoke.mjs",
    "ui:overlap": "node scripts/ui-overlap.mjs",
    "dead": "knip --include files,exports,types",
    "postinstall": "node scripts/patch-expo-speech.mjs && node scripts/patch-sherpa-onnx.mjs"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-speech"
        ]
      }
    }
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kalmi91/kimacha"
  },
  "private": true
}
