    "B1": { "enabled": true, "types": ["choice", "form", "transform", "why", "opencloze", "fix", "bank", "order"] },
    "B2": { "enabled": true, "types": ["choice", "form", "transform", "why", "opencloze", "fix", "bank", "order"] },
    "C1": { "enabled": true, "types": ["choice", "form", "transform", "why", "opencloze", "fix", "bank", "order"] }
  }
